{
  "kind": "collectionType",
  "collectionName": "courses",
  "info": {
    "singularName": "course",
    "pluralName": "courses",
    "displayName": "course",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "text"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "tgat",
        "tpat",
        "a-level"
      ]
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "images"
      ]
    },
    "price": {
      "type": "integer"
    },
    "isPopular": {
      "type": "boolean"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "standard",
        "premium"
      ]
    },
    "courseHours": {
      "type": "integer"
    },
    "fullDescription": {
      "type": "richtext"
    },
    "shortDescription": {
      "type": "text"
    },
    "subjectName": {
      "type": "enumeration",
      "enum": [
        "TGAT1",
        "TGAT2",
        "TGAT3",
        "TPAT1",
        "TPAT2",
        "TPAT3",
        "TPAT4",
        "TPAT5",
        "A-LEVEL PHYSICS",
        "A-LEVEL MATH1",
        "A-LEVEL MATH2",
        "A-LEVEL CHEMISTRY",
        "A-LEVEL BIOLOGY",
        "A-LEVEL SOCIAL",
        "A-LEVEL SCIENCE",
        "A-LEVEL JAPAN",
        "A-LEVEL THAI",
        "A-LEVEL FRANCE",
        "A-LEVEL GERMANY",
        "A-LEVEL CHINESE",
        "A-LEVEL KOREA",
        "A-LEVEL BAHLI",
        "A-LEVEL ENGLISH"
      ]
    },
    "cart": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::cart.cart",
      "mappedBy": "course"
    },
    "favorite": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "api::favorite.favorite",
      "inversedBy": "course"
    },
    "videoExample": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": [
        "files",
        "videos"
      ]
    },
    "lesson": {
      "type": "string"
    },
    "allVideo": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "files",
        "videos"
      ]
    }
  }
}
